rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user has strict isolated access to their own data via UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public verified medical drug reference formulary (Read-only)
    match /drug_reference/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
